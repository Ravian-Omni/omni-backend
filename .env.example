# Application Settings
PORT=8000
PROJECT_NAME="Omni Backend"

# Root directory for file operations
ROOT_DIR=/path/to/your/root/dir

# API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
TOGETHER_API_KEY=your_together_key_here
TAVILY_API_KEY=your_tavily_key_here

# AWS Cognito (if using authentication)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=your_pool_id
COGNITO_CLIENT_ID=your_client_id

# Database (if applicable)
# MONGODB_URI=mongodb://localhost:27017
# DATABASE_NAME=omni_backend

# Logging
LOG_LEVEL=INFO

# ============================================================
# macOS Code Signing & Notarization (for builds)
# ============================================================
# Only required if you're building and signing macOS executables

# Your Developer ID Application certificate name
# Find it by running: security find-identity -v -p codesigning
# Example: "Developer ID Application: John Doe (ABC123XYZ)"
SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"

# Path to entitlements file
# Can use just filename (script searches in scripts/build_scripts/): "entitlements.plist"
# Or relative path from project root: "scripts/build_scripts/entitlements.plist"
# Or absolute path: "/full/path/to/entitlements.plist"
# If not set, defaults to scripts/build_scripts/entitlements.plist
ENTITLEMENTS_FILE="entitlements.plist"

# Your app's bundle identifier (reverse domain notation)
# Example: com.yourcompany.ravian
BUNDLE_ID="com.yourcompany.ravian"

# Your Apple ID email
APPLE_ID="your.email@example.com"

# Your Apple Developer Team ID
# Find it at: https://developer.apple.com/account/
TEAM_ID="YOUR_TEAM_ID"

# App-specific password for notarization
# Generate at: https://appleid.apple.com/account/manage > App-Specific Passwords
# Format: xxxx-xxxx-xxxx-xxxx
APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
